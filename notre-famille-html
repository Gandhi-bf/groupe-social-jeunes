<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Notre Famille - GSJ Connect</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f6f4;
      color: #222;
    }

    header {
      background: #1b5e20;
      color: white;
      text-align: center;
      padding: 24px 15px;
    }

    header h1 {
      margin: 0;
      font-size: 27px;
    }

    header p {
      margin: 7px 0 0;
      font-size: 14px;
    }

    .container {
      max-width: 850px;
      margin: auto;
      padding: 18px;
    }

    .retour {
      display: inline-block;
      color: #1b5e20;
      text-decoration: none;
      font-weight: bold;
      margin-bottom: 18px;
    }

    .intro {
      background: white;
      border-radius: 16px;
      padding: 20px;
      text-align: center;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }

    .intro h2 {
      margin: 0 0 8px;
      color: #1b5e20;
      font-size: 20px;
    }

    .intro p {
      margin: 0;
      color: #666;
      line-height: 1.5;
    }

    .recherche {
      width: 100%;
      padding: 13px 16px;
      border: 1px solid #ccc;
      border-radius: 25px;
      font-size: 15px;
      margin-bottom: 20px;
      outline: none;
    }

    .recherche:focus {
      border-color: #1b5e20;
    }

    .membres {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .membre {
      background: white;
      border-radius: 16px;
      padding: 18px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }

    .photo {
      width: 75px;
      height: 75px;
      border-radius: 50%;
      background: #dce9de;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
    }

    .membre h3 {
      margin: 12px 0 5px;
      font-size: 17px;
    }

    .communaute {
      color: #1b5e20;
      font-size: 13px;
      font-weight: bold;
    }

    .role {
      color: #777;
      font-size: 13px;
      margin-top: 6px;
    }

    .info {
      margin-top: 25px;
      background: #e8f5e9;
      padding: 15px;
      border-radius: 14px;
      text-align: center;
      color: #2e5d32;
      font-size: 13px;
      line-height: 1.5;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #777;
      font-size: 13px;
    }

    @media (max-width: 500px) {
      .membres {
        grid-template-columns: 1fr 1fr;
      }

      .membre {
        padding: 14px 8px;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>👥 Notre Famille</h1>
    <p>GSJ Connect — Groupe Social des Jeunes</p>
  </header>

  <div class="container">

    <a class="retour" href="app-index.html">← Retour à l'accueil</a>

    <div class="intro">
      <h2>🤝 Une seule famille</h2>
      <p>
        Découvrons les membres qui composent notre Groupe Social des Jeunes.
      </p>
    </div>

    <input
      type="text"
      class="recherche"
      placeholder="🔎 Rechercher un membre..."
      onkeyup="rechercherMembre()"
    >

    <div class="membres">

      <div class="membre">
        <div class="photo">👤</div>
        <h3>Jean-Baptiste</h3>
        <div class="communaute">Saint Pierre</div>
        <div class="role">Membre</div>
      </div>

      <div class="membre">
        <div class="photo">👤</div>
        <h3>Marie-Claire</h3>
        <div class="communaute">Sainte Marie</div>
        <div class="role">Membre</div>
      </div>

      <div class="membre">
        <div class="photo">👤</div>
        <h3>Patrick</h3>
        <div class="communaute">Saint Paul</div>
        <div class="role">Membre</div>
      </div>

      <div class="membre">
        <div class="photo">👤</div>
        <h3>Exemple Membre</h3>
        <div class="communaute">Saint Charles Lwanga</div>
        <div class="role">Membre</div>
      </div>

    </div>

    <div class="info">
      🔒 Les informations personnelles des membres seront protégées.
      <br>
      La liste réelle des membres sera connectée progressivement.
    </div>

  </div>

  <footer>
    GSJ Connect — Paroisse Saint Thomas
  </footer>

  <script>

    function rechercherMembre() {

      const recherche = document
        .querySelector(".recherche")
        .value
        .toLowerCase();

      const membres = document.querySelectorAll(".membre");

      membres.forEach(function(membre) {

        const texte = membre.textContent.toLowerCase();

        if (texte.includes(recherche)) {
          membre.style.display = "";
        } else {
          membre.style.display = "none";
        }

      });
    }

  </script>

</body>
</html>
